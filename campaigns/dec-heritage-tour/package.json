{
  "name": "dex-dec-heritage-tour",
  "version": "0.1.0",
  "private": true,
  "description": "Dexterity December Heritage & Relaxation Tour – Remotion production (internal creative review draft)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts HeritageTour out/draft_v1_raw.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --browser-executable=$CHROME_BIN",
